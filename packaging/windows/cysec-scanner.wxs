<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Installer package for Cysec Scanner (engine + Qt GUI + runtimes).

  Built by .github/workflows/release.yml on v* tags with WiX Toolset 5.0.2:

    wix build packaging/windows/cysec-scanner.wxs -arch x64
      -d Version=X.Y.Z -d BundleDir=<assembled bundle directory>

  WiX 5 is licensed MS-RL. WiX 6 and later are deliberately avoided because
  they ship under the FireGiant Open Source Maintenance Fee EULA (D-01).
  WiX 5 still uses the v4 schema namespace below.

  Per-machine x64 install into "C:\Program Files\Cysec Scanner" (D-02), so
  GPO / Intune can deploy it for every user of a machine.

  Unsigned for now (D-03). Authenticode signing of the .msi will be added in
  release.yml right after the "Build the MSI" step, before checksums.

  No WixUI dialog set: WixUI_Minimal and WixUI_InstallDir both show a licence
  agreement page whose default RTF is placeholder CPL text. Doing that right
  needs a custom Apache-2.0 RTF plus the WixToolset.UI.wixext extension, and a
  wrong licence screen would be misleading. Without a UI reference msiexec
  shows its basic progress UI, which is the lowest-risk choice and irrelevant
  for silent GPO / Intune installs. It also means CI installs no extension.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    UpgradeCode identifies the product family forever. It must NEVER change,
    or a new release installs side by side instead of replacing the old one.
  -->
  <Package
      Name="Cysec Scanner"
      Manufacturer="59k GmbH"
      Version="$(var.Version)"
      UpgradeCode="8D9D0D1E-9D4A-4635-B309-DA9233E861C7"
      Scope="perMachine"
      Language="1033"
      Compressed="yes">

    <!--
      MSI ProductVersion is numeric only, so an rc and its final share one
      version (v0.1.3-rc1 and v0.1.3 both map to 0.1.3). Installing the final
      over the rc therefore needs same-version upgrades.
    -->
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        AllowSameVersionUpgrades="yes" />

    <!-- One self-contained .msi: the cabinet is embedded. -->
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/59k-ai/cysec-scanner" />
    <!-- There is no modify UI; offer only repair and remove. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Cysec Scanner" />
    </StandardDirectory>

    <!-- The shortcut goes straight into Programs, no custom folder to remove. -->
    <StandardDirectory Id="ProgramMenuFolder" />

    <!--
      The whole assembled bundle, harvested by WiX 5 Files (replaces heat).
      "**" recurses and mirrors subdirectories (Qt plugins, qml) under
      INSTALLFOLDER exactly; the GUI finds the engine only next to itself, so
      the layout must stay identical to the zip. BundleDir is absolute.
    -->
    <ComponentGroup Id="BundleFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.BundleDir)\**" />
    </ComponentGroup>

    <!--
      Documented WiX shortcut pattern: a non-advertised shortcut needs a
      registry KeyPath, and ICE38/ICE43 want it under HKCU. In a per-machine
      package this may raise an ICE57 warning, which is acceptable (the build
      does not use -wx). If ICE validation ever errors on this component, the
      fallback is Root="HKLM".
    -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut
          Id="GuiShortcut"
          Name="Cysec Scanner"
          Description="Cysec Scanner network scanner"
          Target="[INSTALLFOLDER]cysec-scanner-gui.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue
          Root="HKCU"
          Key="Software\59k\Cysec Scanner"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Cysec Scanner" Level="1">
      <ComponentGroupRef Id="BundleFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
